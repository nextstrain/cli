#!/usr/bin/env bash
set -euo pipefail

base="$(cd "$(dirname "$0")/.."; pwd)"
venv="$base/.venv"

set -x
rm -rf "$venv"
python3 -m venv "$venv"
# Ensure that we are securely upgrading pip to 26.2.2
# <https://discuss.python.org/t/information-for-python-users-regarding-emudhra-emsign-ca-certificate-security-incident/109576>
"$venv"/bin/pip install "pip @ https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl#sha256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70"
"$venv"/bin/pip install --upgrade pip setuptools wheel pip-tools
"$venv"/bin/pip install -e '.[dev]'
